{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Isli Compiler",
      "type": "shell",
      "command": "mingw32-make",
      "options": {
        "cwd": "${workspaceFolder}/isli_compiler",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compiles the standalone Isli compiler using mingw32-make with AVX2 and C++20"
    }
  ]
}
