// Benchmark 20: 1M f64 buffer fill via dispatch kernel (typed buffer + JIT index).
void runBench() {
    int N = 1000000;
    Buffer buf = f64buf(N, 0.0);
    float t0 = clock();
    dispatch(N) {
        |i|
        buf[i] = i * 0.5;
    }
    float t1 = clock();
    float ms = (t1 - t0) * 1000.0;
    print ms;
}

runBench();
