// Benchmark 12: Red-Black Tree / Map (15,000 operations)
void runBench() {
    Map map = rbtree();
    int N = 15000;

    float t0 = clock();
    for (int i = 0; i < N; i = i + 1) {
        rb_insert(map, i, i * 3);
    }
    for (int i = 0; i < N; i = i + 1) {
        int v = rb_get(map, i);
    }
    for (int i = 0; i < N; i = i + 2) {
        rb_remove(map, i);
    }
    float t1 = clock();
    float ms = (t1 - t0) * 1000.0;
    print ms;
}

runBench();
