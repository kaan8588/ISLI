// Benchmark 06: Vector Array Fill (1,000,000 Doubles)
void runBench() {
    int N = 1000000;
    Array a = array(N, 0.0);

    float t0 = clock();
    for (int i = 0; i < N; i = i + 1) {
        a[i] = 42.5;
    }
    float t1 = clock();
    float ms = (t1 - t0) * 1000.0;
    print ms;
}

runBench();
