// Benchmark 14: Closures and Upvalues (10,000 closures)
Function makeAdder(int x) {
    int counter = x;
    int addStep(int step) {
        counter = counter + step;
        return counter;
    }
    return addStep;
}

void runBench() {
    int N = 10000;
    Array list = array(N, 0);

    float t0 = clock();
    for (int i = 0; i < N; i = i + 1) {
        list[i] = makeAdder(i);
    }
    int total = 0;
    for (int i = 0; i < N; i = i + 1) {
        Function fn = list[i];
        total = total + fn(1) + fn(2);
    }
    float t1 = clock();
    float ms = (t1 - t0) * 1000.0;
    print ms;
}

runBench();
