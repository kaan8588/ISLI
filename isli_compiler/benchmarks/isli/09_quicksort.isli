// Benchmark 09: In-Place Quicksort (30,000 integers)
int partition(Array arr, int low, int high) {
    float pivot = arr[high];
    int i = low - 1;
    for (int j = low; j < high; j = j + 1) {
        if (arr[j] <= pivot) {
            i = i + 1;
            float temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
        }
    }
    float temp2 = arr[i + 1];
    arr[i + 1] = arr[high];
    arr[high] = temp2;
    return i + 1;
}

void quickSort(Array arr, int low, int high) {
    if (low < high) {
        int pi = partition(arr, low, high);
        quickSort(arr, low, pi - 1);
        quickSort(arr, pi + 1, high);
    }
}

void runBench() {
    int N = 30000;
    Array arr = array(N, 0);
    int seed = 12345;
    for (int i = 0; i < N; i = i + 1) {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        arr[i] = seed % 100000;
    }

    float t0 = clock();
    quickSort(arr, 0, N - 1);
    float t1 = clock();
    float ms = (t1 - t0) * 1000.0;
    print ms;
}

runBench();
