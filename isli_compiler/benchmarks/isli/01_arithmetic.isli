// Benchmark 01: Arithmetic Loop (10,000,000 iterations)
void runBench() {
    int N = 10000000;
    float t0 = clock();
    float sum = 0.0;
    for (int i = 0; i < N; i = i + 1) {
        sum = sum + (i * 3 - (i / 2) + (i % 7));
    }
    float t1 = clock();
    float ms = (t1 - t0) * 1000.0;
    print ms;
}

runBench();
