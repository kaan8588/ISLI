float deepRec(int depth, float acc) {
    if (depth <= 0) return acc;
    float val = acc * 1.0001 + sqrt(depth * 1.0);
    return deepRec(depth - 1, val);
}

void run() {
    float t0 = clock();
    float total = 0.0;
    for (int i = 0; i < 500; i = i + 1) {
        total = total + deepRec(1000, 1.0);
    }
    float t1 = clock();
    float ms = (t1 - t0) * 1000.0;
    print ms;
}

run();
