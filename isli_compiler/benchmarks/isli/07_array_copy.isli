// Benchmark 07: Vector Array Copy (1,000,000 Doubles)
void runBench() {
    int N = 1000000;
    Array a = array(N, 123.456);
    Array b = array(N, 0.0);

    float t0 = clock();
    for (int i = 0; i < N; i = i + 1) {
        b[i] = a[i];
    }
    float t1 = clock();
    float ms = (t1 - t0) * 1000.0;
    print ms;
}

runBench();
