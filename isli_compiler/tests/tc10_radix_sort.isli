// TC-10: Radix Sort Full Correctness Test
float getMax(Array arr, int n) {
    float mx = arr[0];
    for (int i = 1; i < n; i = i + 1) {
        if (arr[i] > mx) mx = arr[i];
    }
    return mx;
}

void countSort(Array arr, int n, int exp) {
    Array output = array(n, 0);
    Array count = array(10, 0);

    for (int i = 0; i < n; i = i + 1) {
        int digit = floor(arr[i] / exp) % 10;
        count[digit] = count[digit] + 1;
    }

    for (int i = 1; i < 10; i = i + 1) {
        count[i] = count[i] + count[i - 1];
    }

    for (int i = n - 1; i >= 0; i = i - 1) {
        int digit = floor(arr[i] / exp) % 10;
        output[count[digit] - 1] = arr[i];
        count[digit] = count[digit] - 1;
    }

    for (int i = 0; i < n; i = i + 1) {
        arr[i] = output[i];
    }
}

void radixSort(Array arr, int n) {
    float m = getMax(arr, n);
    for (int exp = 1; floor(m / exp) > 0; exp = exp * 10) {
        countSort(arr, n, exp);
    }
}

Array data = [170, 45, 75, 90, 802, 24, 2, 66];
radixSort(data, 8);

print data[0];
print data[1];
