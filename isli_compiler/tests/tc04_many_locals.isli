// TC-04: Many Locals and Deep Stack Test (prevents slot collision)
int computeMany() {
    int a1 = 1;
    int a2 = 2;
    int a3 = 3;
    int a4 = 4;
    int a5 = 5;
    int a6 = 6;
    int a7 = 7;
    int a8 = 8;
    int a9 = 9;
    int a10 = 10;
    int a11 = 11;
    int a12 = 12;
    int a13 = 13;
    int a14 = 14;
    int a15 = 15;
    int a16 = 16;
    int a17 = 17;
    int a18 = 18;
    int a19 = 19;
    int a20 = 20;
    int a21 = 21;
    int a22 = 22;
    int a23 = 23;
    int a24 = 24;
    int a25 = 25;
    
    int sum = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 +
              a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20 +
              a21 + a22 + a23 + a24 + a25;
    return sum;
}

print computeMany();
